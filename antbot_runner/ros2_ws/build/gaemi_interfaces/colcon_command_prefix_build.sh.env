AMENT_PREFIX_PATH=/opt/ros/jazzy
COLCON=1
DEBIAN_FRONTEND=noninteractive
GAEMI_ROS_DISTRO=jazzy
GAEMI_ROS_WS=/home/isaac/gaemi_ros_ws
HOME=/root
HOSTNAME=90603723d16a
HUB__ARGS__DETECT_ONLY=true
HUB__CACHE__PATH=/var/cache/hub
ISAACLAB_PATH=/opt/IsaacLab
ISAACSIM_PATH=/isaac-sim
ISAACSIM_PYTHON_EXE=/isaac-sim/python.sh
LANG=en_US.UTF-8
